<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>All Foods</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1>Food List</h1>
    <a href="/foods/new">Add New Food</a>
    <hr />
    <div>
      <% foods.forEach(food => { %>
      <div class="food-card">
        <h3><a href="/foods/<%= food._id %>"><%= food.name %></a></h3>
        <p><%= food.cuisine %></p>
        <% if(food.img) { %>
        <img src="<%= food.img %>" width="100" />
        <% } %>
      </div>
      <% }) %>
    </div>
  </body>
</html>
