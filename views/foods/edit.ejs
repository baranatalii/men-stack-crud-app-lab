<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/nav') %>

    <div style="text-align: center">
      <h1>Edit <%= food.name %></h1>

      <form action="/foods/<%= food._id %>?_method=PUT" method="POST">
        <label for="name">Food Name:</label>
        <input
          type="text"
          name="name"
          id="name"
          value="<%= food.name %>"
          required
        />

        <label for="cuisine">Cuisine:</label>
        <input
          type="text"
          name="cuisine"
          id="cuisine"
          value="<%= food.cuisine %>"
        />

        <label for="img">Image URL:</label>
        <input type="text" name="img" id="img" value="<%= food.img %>" />

        <label for="calories">Calories:</label>
        <input
          type="number"
          name="calories"
          id="calories"
          value="<%= food.calories %>"
        />

        <label>
          <input type="checkbox" name="isVegetarian" style="display: inline;
          width: auto;" <%= food.isVegetarian ? 'checked' : '' %>> Vegetarian?
        </label>

        <button type="submit" style="margin-top: 20px">
          Update <%= food.name %>
        </button>
      </form>

      <div style="margin-top: 20px">
        <a href="/foods/<%= food._id %>" style="color: #666"
          >Cancel and Go Back</a
        >
      </div>
    </div>
  </body>
</html>
